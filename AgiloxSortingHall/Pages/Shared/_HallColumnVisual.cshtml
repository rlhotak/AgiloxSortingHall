@using AgiloxSortingHall.Enums
@using AgiloxSortingHall.Models
@using AgiloxSortingHall.ViewModels
@model HallColumnViewModel

@{
    var row = Model.Row;
    var maxCapacity = Model.MaxCapacity;

    // pending call-y pro tuto řadu (seřazené podle času požadavku)
    var rowQueue = Model.PendingCalls
        .Where(c => c.HallRowId == row.Id && c.Status == RowCallStatus.Pending)
        .OrderBy(c => c.RequestedAt)
        .ToList();

    // z pending callů vyfiltrujeme ty, které už mají spuštěný workflow na Agiloxu
    var dispatchedCalls = rowQueue
        .Where(c => c.OrderId != null)
        .OrderBy(c => c.RequestedAt)
        .ToList();

    // obsazené sloty v řadě (odspoda nahoru)
    var occupiedSlots = row.Slots
        .Where(s => s.State == PalletState.Occupied)
        .OrderBy(s => s.PositionIndex)
        .ToList();

    // slotId -> popisek stolu (STŮL X)
    var labelBySlotId = new Dictionary<int, string>();

    // RowCally, které už jsme ve vizualizaci přiřadili ke konkrétnímu slotu.
    var mappedCallIds = new HashSet<int>();

    string GetTableLabel(RowCall call)
    {
        if (!string.IsNullOrWhiteSpace(call.WorkTable?.InputStationName))
        {
            return call.WorkTable.InputStationName;
        }

        return call.WorkTable?.DisplayName ?? $"Stůl {call.WorkTableId}";
    }

    string GetVisualLabel(RowCall call)
    {
        var tableName = GetTableLabel(call);

        // zvýraznění aktuálního stolu (na stránce konkrétního stolu)
        if (Model.CurrentTableId.HasValue && call.WorkTableId == Model.CurrentTableId.Value)
        {
            tableName = $"▶ {tableName}";
        }

        return tableName;
    }

    // Pokud Agilox už paletu nabral, RowCall má přesné PickedSlotId.-
    // Popisek proto držíme na tomto slotu, aby se při st avu InTransit neposunul na další paletu nad ním.
    foreach (var call in dispatchedCalls.Where(c => c.PickedSlotId.HasValue))
    {
        var slot = row.Slots.FirstOrDefault(s => s.Id == call.PickedSlotId!.Value);
        if (slot == null)
        {
            continue;
        }

        labelBySlotId[slot.Id] = GetVisualLabel(call);
        mappedCallIds.Add(call.Id);
    }

    // Zbylé dispatched call-y ještě nemají potvrzený pickup, takže je párujeme
    // odspoda na obsazené sloty, které už nejsou svázané s PickedSlotId.
    var unmappedOccupiedSlots = occupiedSlots
        .Where(s => !labelBySlotId.ContainsKey(s.Id))
        .ToList();

    var unmappedDispatchedCalls = dispatchedCalls
        .Where(c => !mappedCallIds.Contains(c.Id))
        .ToList();

    var mapCount = Math.Min(unmappedOccupiedSlots.Count, unmappedDispatchedCalls.Count);

    for (int i = 0; i < mapCount; i++)
    {
        var slot = unmappedOccupiedSlots[i];
        var call = unmappedDispatchedCalls[i];

        labelBySlotId[slot.Id] = GetVisualLabel(call);
        mappedCallIds.Add(call.Id);
    }

    // zbytek fronty = pending cally, které zatím nemají přidělenou paletu
    var remainingQueue = rowQueue
        .Where(c => !mappedCallIds.Contains(c.Id))
        .ToList();

    // text pro tooltip – seznam stolů, které ještě čekají
    string? remainingQueueTooltip = remainingQueue.Any()
        ? string.Join(", ",
            remainingQueue.Select(GetTableLabel))
        : null;
}

<!-- Název řady -->
<div class="header-cell text-center fw-bold mb-1">
    @row.Name
    @if (remainingQueue.Any())
    {
        <span class="badge bg-warning text-dark"
              data-bs-toggle="tooltip"
              title="@remainingQueueTooltip">
            @remainingQueue.Count
        </span>
    }
</div>

<!-- Sloty -->
@for (int pos = maxCapacity - 1; pos >= 0; pos--)
{
    var slot = row.Slots.FirstOrDefault(s => s.PositionIndex == pos);

    var cls = "slot empty";
    string? label = null;

    if (slot != null)
    {
        switch (slot.State)
        {
            case PalletState.Empty:
                cls = "slot empty";
                break;

            case PalletState.Occupied:
                cls = "slot occupied";
                labelBySlotId.TryGetValue(slot.Id, out label);
                break;

            case PalletState.InTransit:
                cls = "slot in-transit";
                labelBySlotId.TryGetValue(slot.Id, out label);
                break;
        }
    }

    <div class="slot-wrapper mb-1">
        <div class="@cls" style="border-color:@row.ColorHex">
            @if (!string.IsNullOrEmpty(label))
            {
                <div class="slot-label">
                    @label
                </div>
            }
        </div>
    </div>
}

<!-- Název artiklu řady -->
<div class="article-label small text-light text-center mt-1">
    @row.Article
</div>
