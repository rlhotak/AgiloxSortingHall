@page
@using AgiloxSortingHall.Enums
@using AgiloxSortingHall.Models
@using AgiloxSortingHall.ViewModels
@using AgiloxSortingHall.Helpers
@model AgiloxSortingHall.Pages.SkladnikModel

@{
    ViewData["Title"] = "Skladník";
    ViewData["BodyClass"] = "no-scroll";

    var maxCapacity = Model.Rows.Any() ? Model.Rows.Max(r => r.Capacity) : 0;
    var columnCount = Model.Rows.Count;
}

<div class="container-fluid hall-page" style="--slot-count:@maxCapacity; --column-count:@columnCount;">

    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center my-3 mx-4">
                <h1 class="mb-0 d-flex align-items-center text-light">
                    <i class="bi bi-person-gear me-2"></i>
                    Skladník
                </h1>

                <div class="d-flex gap-2">
                    <!-- Tlačítko zpět -->
                    <a asp-page="/Index" class="btn btn-outline-secondary btn-lg d-flex align-items-center px-3 py-2">
                        <i class="bi bi-arrow-left me-2 fs-4"></i>
                        <span class="fs-5">Zpět</span>
                    </a>

                    <button class="btn btn-dark btn-lg d-flex align-items-center px-3 py-2"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#settingsPanel"
                            aria-expanded="false"
                            aria-controls="settingsPanel">
                        <i class="bi bi-gear-fill me-2 fs-4"></i>
                        <span class="fs-5">Nastavení</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-12">
            <div class="collapse" id="settingsPanel">
                <div class="card my-2 bg-dark text-light border-secondary">
                    <div class="card-header bg-secondary bg-opacity-25 border-secondary d-flex align-items-center">
                        <i class="bi bi-sliders me-2"></i>
                        <span>Nastavení prioritního výběru řady</span>
                    </div>

                    <div class="card-body">
                        <form method="post" asp-page-handler="SetRowSelectionStrategy" class="mb-0">

                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="strategy"
                                       id="strategyMostFree"
                                       value="MostFreePallets"
                                       @(Model.CurrentStrategy == RowSelectionStrategy.MostFreePallets ? "checked" : "") />
                                <label class="form-check-label" for="strategyMostFree">
                                    Nejvíc volných palet
                                    <small class="text-muted d-block">
                                        Vybere řadu s daným artiklem, kde je nejvíc volných palet.
                                    </small>
                                </label>
                            </div>

                            <div class="form-check mt-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="strategy"
                                       id="strategyLeft"
                                       value="NearestLeft"
                                       @(Model.CurrentStrategy == RowSelectionStrategy.NearestLeft ? "checked" : "") />
                                <label class="form-check-label" for="strategyLeft">
                                    Nejnižší číslo řady
                                    <small class="text-muted d-block">
                                        Vždy bere řadu nejvíc vlevo.
                                    </small>
                                </label>
                            </div>

                            <div class="form-check mt-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="strategy"
                                       id="strategyRight"
                                       value="NearestRight"
                                       @(Model.CurrentStrategy == RowSelectionStrategy.NearestRight ? "checked" : "") />
                                <label class="form-check-label" for="strategyRight">
                                    Nejvyšší číslo řady
                                    <small class="text-muted d-block">
                                        Vždy bere řadu nejvíc vpravo.
                                    </small>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-sm mt-3">
                                Uložit nastavení
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="hall-columns-container">
        @foreach (var row in Model.Rows)
        {
            // najdeme případný pending call pro danou řadu (např. occupied)
            var rowCalls = Model.PendingCalls.Where(c => c.HallRowId == row.Id).ToList();
            AgiloxActivityViewModel? rowActivity = null;
            if (rowCalls.Any())
            {
                // vezmeme ten nejnovější
                var lastCall = rowCalls.OrderByDescending(c => c.RequestedAt).First();
                rowActivity = AgiloxActivityDescriptionHelper.GetActivityUi(lastCall);
            }

            <div class="hall-column">

                @await Html.PartialAsync(
                "_HallColumnVisual",
                        new HallColumnViewModel
                        {
                            Row = row,
                            MaxCapacity = maxCapacity,
                            PendingCalls = Model.PendingCalls,
                            CurrentTableId = null
                        }
                        )

            @* případná hláška k řadě (occupied / error) *@
            @if (rowActivity != null && rowActivity.Severity != AgiloxSeverity.Info)
                {
                    <div class="mt-1 small @rowActivity.TextCss">
                        <i class="bi @rowActivity.IconCss me-1"></i>
                        @rowActivity.Text
                    </div>
                }

              <form method="post" class="w-100 mt-1" id="row-form-@row.Id">
                    <input type="hidden" name="rowId" value="@row.Id" />

                    <input type="text"
                           class="form-control bg-dark text-light border-secondary article-input mt-1"
                           placeholder="Název artiklu"
                           name="RowArticle[@row.Id]"
                           value="@(Model.RowArticle[row.Id])" />

                    <button class="btn btn-dark w-100 mt-1 article-save-btn d-flex align-items-center justify-content-center border-secondary"
                            type="submit"
                            asp-page-handler="SetArticle">
                        <i class="bi bi-pencil-fill fs-8 text-info"></i>
                    </button>

                    <button class="btn btn-success btn-lg w-100 fw-bold mt-2 d-flex align-items-center justify-content-center icon-white"
                            type="submit"
                            asp-page-handler="AddPallet">
                        <i class="bi bi-plus-lg"></i>
                    </button>

                    <button class="btn btn-outline-danger btn-lg w-100 fw-bold mt-1 d-flex align-items-center justify-content-center border-danger icon-white"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#confirmRemoveModal"
                            data-row-id="@row.Id">
                        <i class="bi bi-dash-lg"></i>
                    </button>
                </form>

            </div>
        }
    </div>
</div>

<!-- Modal pro potvrzení odebrání palety -->
<div class="modal fade" id="confirmRemoveModal" tabindex="-1" aria-labelledby="confirmRemoveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title d-flex align-items-center" id="confirmRemoveModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    Odebrat paletu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Opravdu chceš odebrat jednu paletu z této řady?</p>
                <p class="text-muted small mb-0">
                    Určeno pouze pro opravu omylem přidané palety.
                </p>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zrušit</button>

                @* VLASTNÍ FORM PRO REMOVE PALLET *@
                <form method="post" asp-page-handler="RemovePallet" id="removePalletForm" class="m-0">
                    <input type="hidden" name="rowId" id="removePalletRowId" value="" />
                    <button type="submit" class="btn btn-danger" id="confirmRemoveBtn">
                        Odebrat paletu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal pro chybovou hlášku -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-danger">
            <div class="modal-header border-danger">
                <h5 class="modal-title d-flex align-items-center" id="errorModalLabel">
                    <i class="bi bi-x-octagon-fill text-danger me-2"></i>
                    Chyba
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Zavřít"></button>
            </div>
            <div class="modal-body">
                @Model.ErrorMessage
            </div>
            <div class="modal-footer border-danger">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- tvůj existující kód pro confirmRemoveModal ---
            var confirmModal = document.getElementById('confirmRemoveModal');
            var rowIdInput = document.getElementById('removePalletRowId');

            confirmModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var rowId = button ? button.getAttribute('data-row-id') : null;

                if (rowIdInput && rowId) {
                    rowIdInput.value = rowId;
                }
            });

            // --- AUTO-OPEN error modal (klik mimo zavře) ---
            var errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ErrorMessage ?? ""));
            if (errorMessage.trim().length > 0) {
                var errorModalEl = document.getElementById('errorModal');
                if (errorModalEl) {
                    var errorModal = new bootstrap.Modal(errorModalEl, {
                        backdrop: true,  // klik mimo zavře
                        keyboard: true   // ESC zavře
                    });
                    errorModal.show();
                }
            }
        });
    </script>
}

}
